# 阿里云百炼 API（出图优先级最高，配置后走百炼）
BAILIAN_API_KEY=sk-your-api-key-here
BAILIAN_WORKSPACE_ID=your-workspace-id
BAILIAN_MODEL=wan2.7-image

# MiniMax API（百炼的替代方案，出图优先级次之）
MINIMAX_API_KEY=
# 国内站用 api.minimaxi.com，国际站用 api.minimax.io，两者密钥不通用
MINIMAX_BASE_URL=https://api.minimaxi.com
# H3-Image 支持最多 16 张参考图（每件单品单独传）；Highspeed 版更快，参数相同
MINIMAX_IMAGE_MODEL=MiniMax-H3-Image
# 竖版画幅可以避免模型把整套搭配画成左右并排的三联画
MINIMAX_ASPECT_RATIO=2:3

# Mock 模式开关：设为 true 强制使用本地示意图渲染
AI_IMAGE_USE_MOCK=false
